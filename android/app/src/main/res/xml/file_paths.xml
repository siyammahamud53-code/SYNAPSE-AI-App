    <files-path
        name="internal_files"
        path="/" />
    
    <cache-path
        name="internal_cache"
        path="/" />
    
    <!-- External Storage -->
    <external-files-path
        name="external_files"
        path="/" />
    
    <external-cache-path
        name="external_cache"
        path="/" />
    
    <external-path
        name="external_root"
